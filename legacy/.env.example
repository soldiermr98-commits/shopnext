# Generate independently, e.g. openssl rand -base64 64. Required; no fallback.
JWT_SECRET=
# Fresh DB bootstrap only; 14–72 bytes. Change via authenticated first-login form.
ADMIN_INITIAL_PASSWORD=
# Cookies are always Secure; browser development requires HTTPS proxy (Arena preview works).
NODE_ENV=development
PORT=3000
# Optional absolute directory outside checkout. Never commit a database.
DATA_DIR=
# Comma-separated exact browser origins; required in perimeter step.
CORS_ORIGINS=
